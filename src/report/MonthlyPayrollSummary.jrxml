        <parameter name="payStartDate" class="java.sql.Date"/>
        <parameter name="payEndDate"  class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[
                    SELECT *
                    FROM payrollsystem_db.monthlypayrollsummaryreportview
                    WHERE payStartDate >= $P{payStartDate}
                    AND payEndDate   <= $P{payEndDate}
                ]]>
	</queryString>
